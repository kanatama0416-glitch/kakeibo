-- 楽天カードGmail取込用の列と重複防止
alter table public.transactions
  drop constraint if exists transactions_source_message_id_key;

alter table public.transactions
  drop constraint if exists transactions_source_check;

alter table public.transactions
  add constraint transactions_source_check
  check (source in ('manual','epos_email','rakuten_email','csv'));

alter table public.transactions
  add column if not exists source_item_index integer not null default 0,
  add column if not exists source_received_at timestamptz,
  add column if not exists card_provider text,
  add column if not exists card_label text;

drop index if exists public.transactions_source_message_item_uidx;

alter table public.transactions
  drop constraint if exists transactions_source_message_item_key;

alter table public.transactions
  add constraint transactions_source_message_item_key
  unique (source_message_id, source_item_index);
